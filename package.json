{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/cli.ts serve",
    "harness": "node --import tsx src/cli.ts",
    "runtime:opencode": "node --import tsx src/runtime-cli.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "build:native": "node scripts/build-native.mjs",
    "pretest": "node scripts/build-native.mjs --test",
    "format": "prettier --write src web test scripts conformance runtime",
    "format:check": "prettier --check src web test scripts conformance runtime",
    "test:workers:live": "node scripts/build-native.mjs && node --import tsx --test --test-reporter=spec conformance/live/workers.test.ts",
    "benchmark:authorization": "node --import tsx conformance/authorization-benchmark.ts",
    "test:opencode:live": "node --import tsx --test --test-reporter=spec conformance/live/opencode.test.ts",
    "test:opencode:engine": "node --import tsx --test --test-reporter=spec conformance/live/engine-opencode.test.ts",
    "test:opencode:specialists": "node --import tsx --test --test-reporter=spec conformance/live/specialists-opencode.test.ts"
  },
  "dependencies": {
    "minimatch": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
