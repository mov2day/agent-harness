FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update && apt-get install -y --no-install-recommends clang git python3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/agent-harness
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN chown -R node:node /opt/agent-harness
USER node
CMD ["npm", "run", "verify"]
